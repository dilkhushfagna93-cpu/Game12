# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APK_DOWNLOAD_URL: Set to a valid HTTPS URL hosting the signed Aurelia Arena Android APK.
# Leave empty until a real Android APK build is uploaded (displays "Android APK Coming Soon").
APK_DOWNLOAD_URL=""
APK_VERSION="1.0.0"
APK_SIZE="48.6 MB"
APK_UPDATED_AT="2026-11-26"
APK_ANDROID_COMPAT="Android 9.0 (Pie) or higher · ARM64 / ARMv7"
