        "status": { "type": "string", "enum": ["waiting", "playing", "finished"] },
        "entryFee": { "type": "number" },
        "currentTurnIndex": { "type": "number" },
        "diceValue": { "type": "number" },
        "diceRolled": { "type": "boolean" },
        "consecutiveSixes": { "type": "number" },
        "winnerUid": { "type": "string", "maxLength": 128 },
        "winnerName": { "type": "string", "maxLength": 32 },
        "playerUids": { "type": "array" },
        "players": { "type": "array" },
        "tokens": { "type": "object" },
        "lastMoveNote": { "type": "string", "maxLength": 200 },
        "turnStartedAtMs": { "type": "number" },
        "missedTurns": { "type": "object" },
        "lastReaction": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "code", "hostUid", "hostName", "maxPlayers", "status", "entryFee", "currentTurnIndex", "diceValue", "diceRolled", "consecutiveSixes", "winnerUid", "winnerName", "playerUids", "players", "tokens", "lastMoveNote", "createdAt", "updatedAt"]
    },
    "TeenPattiRoom": {
      "title": "TeenPattiRoom",
