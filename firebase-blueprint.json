        "roomId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 6, "maxLength": 8, "pattern": "^[A-Z0-9]+$" },
        "hostUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hostName": { "type": "string", "minLength": 2, "maxLength": 32 },
        "maxPlayers": { "type": "number" },
        "isPrivate": { "type": "boolean" },
        "bootAmount": { "type": "number" },
        "chaalLimit": { "type": "number" },
        "potLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["waiting", "playing", "showdown", "finished"] },
        "roundId": { "type": "string", "maxLength": 128 },
        "handNumber": { "type": "number" },
        "dealerIndex": { "type": "number" },
        "currentTurnIndex": { "type": "number" },
        "currentStake": { "type": "number" },
        "pot": { "type": "number" },
        "winnerUid": { "type": "string", "maxLength": 128 },
        "winnerName": { "type": "string", "maxLength": 32 },
        "winnerHandLabel": { "type": "string", "maxLength": 64 },
        "winnerPayout": { "type": "number" },
        "serverSeedHash": { "type": "string", "maxLength": 128 },
        "serverSeed": { "type": "string", "maxLength": 128 },
        "playerUids": { "type": "array" },
        "players": { "type": "array" },
        "sideShowRequest": { "type": "object" },
        "lastReaction": { "type": "object" },
        "lastActionNote": { "type": "string", "maxLength": 220 },
        "turnStartedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "code", "hostUid", "hostName", "maxPlayers", "isPrivate", "bootAmount", "chaalLimit", "potLimit", "status", "roundId", "handNumber", "dealerIndex", "currentTurnIndex", "currentStake", "pot", "winnerUid", "winnerName", "winnerHandLabel", "winnerPayout", "serverSeedHash", "serverSeed", "playerUids", "players", "lastActionNote", "turnStartedAtMs", "createdAt", "updatedAt"]
    },
    "GameConfig": {
      "title": "GameConfig",
      "description": "Admin-managed game configuration, maintenance controls, UPI deposit handles, support channels, and APK metadata.",
      "type": "object",
      "properties": {
        "gameId": { "type": "string", "enum": ["dragon_tiger", "ludo", "aviator", "teen_patti", "platform"] },
        "enabled": { "type": "boolean" },
        "minBet": { "type": "number" },
        "maxBet": { "type": "number" },
        "version": { "type": "string", "maxLength": 32 },
        "apkDownloadUrl": { "type": "string", "maxLength": 512 },
        "apkVersion": { "type": "string", "maxLength": 32 },
        "apkSize": { "type": "string", "maxLength": 32 },
        "apkUpdatedAt": { "type": "string", "maxLength": 32 },
        "apkAndroidCompat": { "type": "string", "maxLength": 64 },
        "maintenanceMessage": { "type": "string", "maxLength": 240 },
        "depositUpiId": { "type": "string", "maxLength": 100 },
        "depositUpiName": { "type": "string", "maxLength": 64 },
        "depositQrUrl": { "type": "string", "maxLength": 512 },
        "whatsappSupportUrl": { "type": "string", "maxLength": 256 },
        "telegramSupportUrl": { "type": "string", "maxLength": 256 },
        "matchmakingDifficulty": { "type": "string", "enum": ["casual", "balanced", "competitive"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gameId", "enabled", "minBet", "maxBet", "version", "apkDownloadUrl", "apkVersion", "apkSize", "apkUpdatedAt", "apkAndroidCompat", "maintenanceMessage", "updatedAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User support ticket, payment/UTR issue, game issue, cheating report, or bug report with admin replies.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 2, "maxLength": 32 },
        "category": { "type": "string", "enum": ["payment", "game", "bug", "cheating", "account", "contact", "other"] },
        "subject": { "type": "string", "minLength": 3, "maxLength": 120 },
        "message": { "type": "string", "minLength": 5, "maxLength": 1200 },
        "targetUsername": { "type": "string", "maxLength": 32 },
        "utrRef": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved"] },
        "adminNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "userId", "username", "category", "subject", "message", "targetUsername", "status", "adminNote", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted RBAC admin document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "PlatformLiquiditySettings": {
      "title": "PlatformLiquiditySettings",
      "description": "Unified 4-tier platform liquidity, risk control, and smart matchmaking configuration stored at settings/platform.",
      "type": "object",
      "properties": {
        "liquidityMode": { "type": "string", "enum": ["easy", "balanced", "pro", "ultra-pro"] },
        "maxRoundPayoutCap": { "type": "number" },
        "smartMatchmakingEnabled": { "type": "boolean" },
        "matchmakingWaitSeconds": { "type": "number" },
        "welcomeBonusAmount": { "type": "number" },
        "signupBonus": { "type": "number" },
        "requireFirstDepositToWithdraw": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["liquidityMode", "maxRoundPayoutCap", "smartMatchmakingEnabled", "matchmakingWaitSeconds", "updatedAt"]
    },
    "SignupBonusClaim": {
      "title": "SignupBonusClaim",
      "description": "Immutable one-time signup bonus claim lock keyed by uid or hashed email/phone identifier.",
      "type": "object",
      "properties": {
        "claimId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "claimType": { "type": "string", "enum": ["uid", "email", "phone"] },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["claimId", "uid", "claimType", "amount", "createdAt"]
    }
  },
  "firestore": {
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public player leaderboard stats, split balances, VIP wager volume, and non-PII profile information."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user account metadata, email, daily streaks, referral metadata, and withdrawal rate counters."
    },
    "/walletTransactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Immutable virtual coin ledger records."
    },
    "/upiRequests/{requestId}": {
      "schema": { "$ref": "#/entities/UpiRequest" },
      "description": "Direct UPI deposit and withdrawal requests awaiting or settled by admin review."
    },
    "/upiUtrs/{utr}": {
      "schema": { "$ref": "#/entities/UpiUtrLock" },
      "description": "Unique 12-digit UTR registry enforcing one-time deposit redemption."
    },
    "/promoCodes/{code}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "Admin-managed promotional bonus codes for deposit bonuses."
    },
    "/promoRedemptions/{redemptionId}": {
      "schema": { "$ref": "#/entities/PromoRedemption" },
      "description": "Immutable per-user promo code redemption locks."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable audit trail of administrative balance adjustments, freezes, and settings changes."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Referral relationships unlocking bonus credits strictly after the referred player completes a real game."
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCodeMap" },
      "description": "Public code-to-UID lookup map for referral onboarding."
